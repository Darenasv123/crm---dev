# ═══════════════════════════════════════════════════════════════════════
# advocate-nest — Variables de entorno de STAGING (Fase 8I-B1)
# ═══════════════════════════════════════════════════════════════════════
# SOLO NOMBRES Y PLACEHOLDERS. Ningún valor de este archivo es un secreto
# real ni un valor productivo. Ver server-release/docs/ENVIRONMENT_VARIABLES.md
# para la descripción completa de cada variable y
# server-release/docs/GOOGLE_DRIVE_REAL_VALIDATION_RUNBOOK.md Sección 39
# para el diseño completo del entorno de staging.
#
# NUNCA:
#   - copiar aquí un valor real de producción (Supabase, OAuth, secretos);
#   - commitear un archivo .env.staging real con valores rellenos;
#   - reutilizar el proyecto Supabase o el OAuth Client de producción.
#
# Este archivo es un TEMPLATE — no se usa para arrancar nada tal cual.
# ═══════════════════════════════════════════════════════════════════════

# ── ENTORNO ────────────────────────────────────────────────────────────
NODE_ENV=production

# ── RED ────────────────────────────────────────────────────────────────
# Puerto distinto del de producción (3000) — confirmar cuál está libre en
# el servidor real antes de fijarlo (ver runbook Sección 39.P).
HOST=127.0.0.1
PORT=<staging-only-confirm-free-port>

# URL pública de staging (dominio PENDING — ver runbook Sección 39.C).
APP_URL=https://<staging-domain-pending>

# ── SUPABASE (proyecto STAGING dedicado, nunca el de producción) ───────
SUPABASE_URL=<staging-only>
SUPABASE_SERVICE_ROLE_KEY=<staging-only>
VITE_SUPABASE_URL=<staging-only>
VITE_SUPABASE_ANON_KEY=<staging-only>

# ── GOOGLE CALENDAR — debe permanecer DESHABILITADO en staging ─────────
# Dejar todo este bloque vacío. Su sola ausencia desactiva Calendar en la
# UI sin ningún cambio de código (ver runbook Sección 39.G).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_CALENDAR_MAINTENANCE_SECRET=
GOOGLE_SHARED_CALENDAR_ID=
VITE_GOOGLE_CLIENT_ID=

# ── GOOGLE DRIVE (proyecto de testing dedicado — ver runbook Sección 39.J) ──
# Dejar vacío hasta completar BLOCK C de la secuencia E2E (runbook Sección
# 39.M). Si se define CUALQUIERA de las 3 primeras, las 6 núcleo pasan a
# ser obligatorias (ver scripts/validate-production-env.mjs).
GOOGLE_DRIVE_CLIENT_ID=<testing-project-only>
GOOGLE_DRIVE_CLIENT_SECRET=<testing-project-only>
GOOGLE_DRIVE_REDIRECT_URI=https://<staging-domain-pending>/api/google-drive/callback

# Compartidos en el esquema de variables, pero deben tener un valor PROPIO
# de staging — nunca el mismo valor que producción.
GOOGLE_OAUTH_STATE_SECRET=<staging-only-generate-own>
GOOGLE_TOKEN_ENCRYPTION_KEY=<staging-only-generate-own>

GOOGLE_DRIVE_MAINTENANCE_SECRET=<staging-only-generate-own>

# Opcional incluso con Drive habilitado (ver runbook Sección 26 — watch al
# final). Dejar vacío hasta BLOCK J de la secuencia E2E.
GOOGLE_DRIVE_WEBHOOK_URL=

# ── CORREO (SMTP) — debe permanecer DESHABILITADO en staging ───────────
# Dejar todo este bloque vacío (ver runbook Sección 39.G).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=

# ── FEATURE FLAGS ───────────────────────────────────────────────────────
VITE_PASSWORD_RECOVERY_ENABLED=false

# ── CHATBOT LEX (opcional) ──────────────────────────────────────────────
GROQ_API_KEY=

# ── FUTURA IMPORTACIÓN DOCUMENTAL (no usada en este release) ───────────
DOCUMENT_ANALYSIS_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
CF_IMPORT_QUEUE=
CF_IMPORT_WORKFLOW=
