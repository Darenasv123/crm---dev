# ═══════════════════════════════════════════════════════════════════════
# advocate-nest — Variables de entorno de PRODUCCIÓN
# ═══════════════════════════════════════════════════════════════════════
# Copia este archivo como .env.production en el servidor y rellena los valores reales.
# NUNCA incluyas este archivo con valores reales en Git.
#
# Cómo usar en producción:
#   cp config/.env.production.example .env.production
#   nano .env.production   ← editar con valores reales
#   node app/server/index.mjs
#
# El servidor lee estas variables en runtime.
# Las variables VITE_* fueron incrustadas en el bundle durante el build.
# ═══════════════════════════════════════════════════════════════════════

# ── ENTORNO ────────────────────────────────────────────────────────────
# Obligatoria. Debe ser exactamente "production".
NODE_ENV=production

# ── RED ────────────────────────────────────────────────────────────────
# HOST: IP de escucha. 127.0.0.1 para que solo Apache/Nginx pueda acceder.
# No usar 0.0.0.0 salvo que el servidor tenga firewall que bloquee el puerto.
HOST=127.0.0.1

# PORT: Puerto HTTP interno. El proxy inverso redirigirá aquí.
# El puerto 3000 no debe estar expuesto directamente a Internet.
PORT=3000

# APP_URL: URL pública del CRM (para referencias internas y logs).
APP_URL=https://abogado.consoldi.com

# ── SUPABASE ───────────────────────────────────────────────────────────
# Obligatorias. Se leen en runtime para operaciones de servidor.

# URL del proyecto Supabase (igual que VITE_SUPABASE_URL del build).
SUPABASE_URL=https://PROJECT_ID.supabase.co

# SECRETO — Clave service_role. NUNCA en el frontend ni en el bundle.
# Supabase → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME

# ── GOOGLE CALENDAR ────────────────────────────────────────────────────
# Todas son obligatorias si se usa la integración con Google Calendar.
# Si no se necesita Google Calendar, pueden dejarse vacías (la UI lo indicará).

# Client ID de la app OAuth en Google Cloud Console.
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# SECRETO — Client Secret de la app OAuth.
# Google Cloud Console → APIs & Services → Credentials → tu app OAuth
GOOGLE_CLIENT_SECRET=CHANGE_ME

# URI de redirección OAuth registrada en Google Cloud Console.
# Debe coincidir EXACTAMENTE con lo configurado en la consola de Google.
GOOGLE_OAUTH_REDIRECT_URI=https://abogado.consoldi.com/api/google-calendar/callback

# SECRETO — Cadena aleatoria de al menos 32 caracteres.
# Se usa para firmar el parámetro "state" del flujo OAuth y prevenir CSRF.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_OAUTH_STATE_SECRET=CHANGE_ME_32_CHARS_MIN

# SECRETO — Cadena aleatoria de al menos 32 caracteres.
# Se usa para cifrar refresh tokens de Google con AES-GCM antes de guardarlos en Supabase.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=CHANGE_ME_32_CHARS_MIN

# URL HTTPS pública del webhook de Google Calendar.
# Google enviará notificaciones POST a esta URL cuando haya cambios en el calendario.
# Debe ser accesible públicamente desde Internet.
GOOGLE_CALENDAR_WEBHOOK_URL=https://abogado.consoldi.com/api/google-calendar/webhook

# ID del calendario compartido (opcional).
# Puede configurarse desde la interfaz de administración del CRM.
# Ejemplo: nombre@gmail.com o c_abc123@group.calendar.google.com
GOOGLE_SHARED_CALENDAR_ID=

# ── GROQ (Chatbot Lex) ─────────────────────────────────────────────────
# SECRETO — Clave de la API de Groq para el asistente de IA.
# Obtener en: https://console.groq.com
# La clave empieza con "gsk_"
# Si no se usa el chatbot, puede dejarse vacía.
GROQ_API_KEY=gsk_CHANGE_ME

# ── NOTAS DE SEGURIDAD ─────────────────────────────────────────────────
# Las variables marcadas como SECRETO no deben:
# - Aparecer en logs del servidor
# - Incluirse en respuestas HTTP
# - Guardarse en Git
# - Pasarse como argumentos de línea de comandos (visibles en ps aux)
# - Compartirse por email o Slack sin cifrar
#
# Método recomendado: guardar en archivo .env.production con permisos 600
#   chmod 600 .env.production
#   chown abogado:abogado .env.production
