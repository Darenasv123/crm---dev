# ═══════════════════════════════════════════════════════════════════════
# ENTORNO DE PRUEBA — CRM Estudio Jurídico Arenas
# ═══════════════════════════════════════════════════════════════════════
# Copia este archivo como .env.staging (ya está en .gitignore vía *.local
# y .env.*.local). Para usarlo, renómbralo a .env.staging.local o
# carga las variables manualmente antes de ejecutar los tests:
#
#   $env:VITE_SUPABASE_URL="https://TU-PROYECTO-PRUEBA.supabase.co"
#   $env:VITE_SUPABASE_ANON_KEY="tu_anon_key_de_prueba"
#   $env:SUPABASE_SERVICE_ROLE_KEY="tu_service_role_key_de_prueba"
#   npm run test:staging
#
# IMPORTANTE: Este archivo nunca debe contener credenciales reales.
# ═══════════════════════════════════════════════════════════════════════

# ── Proyecto Supabase de PRUEBA (NO el de producción) ──────────────────
# Crea un proyecto nuevo en https://supabase.com/dashboard/projects
# Nombre sugerido: "advocate-nest-staging" o "crm-juridico-prueba"
# Una vez creado: Settings → API → Project URL y anon public key

VITE_SUPABASE_URL=https://PROYECTO-DE-PRUEBA.supabase.co
VITE_SUPABASE_ANON_KEY=CLAVE_ANON_DE_PRUEBA

# Service Role Key — solo para tests de integración, NUNCA en el frontend
# Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=CLAVE_SERVICE_ROLE_DE_PRUEBA

# ── Identificador del proyecto de prueba ──────────────────────────────
# Reemplaza con la referencia del proyecto de prueba (ej: abcdefghijk)
# Se usa para confirmar que los tests no apuntan a producción
SUPABASE_STAGING_PROJECT_REF=REFERENCIA-DEL-PROYECTO-PRUEBA

# ── Flag de autorización para tests destructivos ──────────────────────
# Debe ser exactamente "true" para que los tests de integración se ejecuten
ALLOW_STAGING_TESTS=true

# ── Credenciales de usuario de prueba ─────────────────────────────────
# Crea un usuario en el proyecto de prueba con rol "Administrador"
# Auth → Users → Add user
STAGING_TEST_EMAIL=usuario-prueba@ejemplo.com
STAGING_TEST_PASSWORD=contraseña-segura-de-prueba
